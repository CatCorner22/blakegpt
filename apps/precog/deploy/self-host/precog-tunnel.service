[Unit]
Description=Cloudflare Tunnel for Precog
After=network-online.target precog.service
Wants=network-online.target
Requires=precog.service

[Service]
DynamicUser=true
LoadCredential=tunnel-token:/etc/precog/tunnel.token
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file ${CREDENTIALS_DIRECTORY}/tunnel-token
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
